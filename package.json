{
  "name": "explorer-folder-filter",
  "displayName": "Explorer Folder Filter",
  "description": "Temporarily focus the native VS Code Explorer on matching folders.",
  "version": "0.1.0",
  "publisher": "RobertLD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RobertLD/explorer-folder-filter.git"
  },
  "keywords": [
    "explorer",
    "filter",
    "folders",
    "workspace",
    "files.exclude"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Explorer Folder Filter reads folders directly from the file system."
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "explorerFilter.focus",
        "title": "Filter",
        "category": "Focus Folder",
        "icon": "$(filter)"
      },
      {
        "command": "explorerFilter.clear",
        "title": "Clear Filter",
        "category": "Focus Folder",
        "icon": "$(filter-filled)"
      },
      {
        "command": "explorerFilter.toggle",
        "title": "Toggle Filter",
        "category": "Focus Folder"
      },
      {
        "command": "explorerFilter.focusFolder",
        "title": "Focus on This Folder",
        "category": "Focus Folder"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "explorerFilter.focusFolder",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "explorerFilter.focus",
          "when": "view == workbench.explorer.fileView && !explorerFolderFilter.active",
          "group": "navigation"
        },
        {
          "command": "explorerFilter.clear",
          "when": "view == workbench.explorer.fileView && explorerFolderFilter.active",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "explorerFilter.focusFolder",
          "when": "explorerResourceIsFolder && !explorerResourceIsRoot",
          "group": "4_search"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js",
    "test": "npm run test:unit",
    "test:unit": "npm run compile && node --test dist/test/*.test.js",
    "test:vscode": "npm run compile && node dist/test/run-vscode-tests.js",
    "test:all": "npm run test:unit && npm run test:vscode",
    "package": "npm run test && npm run bundle && vsce package --out explorer-folder-filter.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.74.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  }
}
